# Dependências
node_modules/

# Build da página: o Vite gera panel/ui/dist/ e o scripts/publish.js junta tudo em panel/index.html
# (o index.html compilado É versionado; o dist/ não)
panel/ui/dist/

# Raízes temporárias dos testes e da demonstração com o servidor real (build-mock-root.js)
panel/tests/tmp/

# Os dados ficam fora do repositório (MAESTRO_DIR, padrão ~/.painel-maestro). Versões antigas do painel gravavam
# nestas pastas, dentro do repositório; elas não são mais lidas, mas continuam ignoradas para nunca irem ao git.
registro/
estado/
/state/
logs/
.segredos/

# Temporários
*.tmp

# Diversos
npm-debug.log*
.DS_Store
Thumbs.db
