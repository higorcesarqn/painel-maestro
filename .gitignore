# Dependências
node_modules/

# Build da página: o Vite gera panel/ui/dist/ e o scripts/publish.js junta tudo em panel/index.html
# (o index.html compilado É versionado; o dist/ não)
panel/ui/dist/

# Raízes temporárias dos testes e da demonstração (build-mock-root.js)
panel/tests/tmp/

# Dados do seu workspace. Sem MAESTRO_DIR, o servidor e os scripts de bin/ leem e gravam
# na raiz deste repositório: nada disso pode ir para o git.
registro/
estado/
/state/
logs/
.segredos/

# Travas e temporários das gravações atômicas (lib.js)
*.lock
*.tmp
*.tmp-*

# Diversos
npm-debug.log*
.DS_Store
Thumbs.db
